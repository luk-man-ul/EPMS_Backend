generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskType {
  ASSIGNED
  SELF_WORK
}

enum TaskStatus {
  PROPOSED
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum TicketType {
  BUG
  FEATURE
  SUPPORT
  IMPROVEMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  WFH
}

enum WorkMode {
  ON_SITE
  WFH
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
  UNPAID
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChannelType {
  COMPANY
  PROJECT
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerReferenceType {
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

//////////////////////////////////////////////////////
// AUTH & RBAC
//////////////////////////////////////////////////////

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  designation  String?
  department   String?
  profilePhoto String?
  joinedAt     DateTime?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  tokenVersion Int        @default(0)
  workMode     WorkMode   @default(ON_SITE)

  roles  UserRole[]
  skills UserSkill[] // 👈 NEW

  // Project relations
  createdProjects Project[]       @relation("ProjectCreator")
  ledProjects     Project[]       @relation("ProjectLead")
  projectMembers  ProjectMember[]

  // Task relations
  assignedTasks       Task[]              @relation("TaskAssignee")
  createdTasks        Task[]              @relation("TaskCreator")
  approvedTasks       Task[]              @relation("TaskApprover")
  changedTaskStatuses TaskStatusHistory[] @relation("TaskStatusChanger")

  // Ticket relations
  reportedTickets     Ticket[]              @relation("TicketReporter")
  assignedTickets     Ticket[]              @relation("TicketAssignee")
  ticketStatusChanges TicketStatusHistory[]

  // Comments
  comments Comment[]

  // Self work
  selfWorks         SelfWork[] @relation("SelfWorkOwner")
  approvedSelfWorks SelfWork[] @relation("SelfWorkApprover")

  // Leave
  leaveRequests  LeaveRequest[] @relation("LeaveRequester")
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")

  // WFH
  wfhRequests    WfhRequest[]   @relation("WfhRequester")
  approvedWfh    WfhRequest[]   @relation("WfhApprovedBy")

  attendance         Attendance[]
  attendanceSessions AttendanceSession[]

  // System
  notifications   Notification[]
  messages        Message[]        @relation("MessageSender")
  chatMessages    ChatMessage[]    @relation("ChatMessageSender")
  chatRoomMembers ChatRoomMember[] @relation("ChatRoomMemberUser")
  activityFeed    ActivityFeed[]
  auditLogs       AuditLog[]
  uploadedFiles   FileAttachment[]

  // Finance back-relations
  expenses        Expense[] @relation("ExpenseEmployee")
  createdRevenues Revenue[] @relation("RevenueCreator")
  createdExpenses Expense[] @relation("ExpenseCreator")
  createdLedgerEntries LedgerEntry[] @relation("LedgerEntryCreator")
  createdInvoices      Invoice[]     @relation("InvoiceCreator")

  // Auth
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

//////////////////////////////////////////////////////
// SKILLS MODULE (NEW)
//////////////////////////////////////////////////////

model Skill {
  id    String      @id @default(uuid())
  name  String      @unique
  users UserSkill[]

  createdAt DateTime @default(now())

  @@index([name])
}

model UserSkill {
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

//////////////////////////////////////////////////////
// PROJECTS
//////////////////////////////////////////////////////

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  createdById String
  leadId      String?

  createdBy User  @relation("ProjectCreator", fields: [createdById], references: [id])
  lead      User? @relation("ProjectLead", fields: [leadId], references: [id])

  members   ProjectMember[]
  tasks     Task[]
  tickets   Ticket[]
  selfWorks SelfWork[]
  finance   ProjectFinance?
  channels  Channel[]
  chatRooms ChatRoom[]

  // Finance back-relations
  revenues Revenue[]
  expenses Expense[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ProjectMember {
  projectId     String
  userId        String
  roleInProject String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

//////////////////////////////////////////////////////
// TASKS
//////////////////////////////////////////////////////

model Task {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)

  // Task type classification
  type TaskType @default(ASSIGNED)

  assignedToId String?
  createdById  String

  // Approval metadata
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  dueDate      DateTime?
  estimatedHrs Float?
  actualHrs    Float?
  completedAt  DateTime?

  position  Int     @default(0)
  isDeleted Boolean @default(false)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  creator    User    @relation("TaskCreator", fields: [createdById], references: [id])
  approvedBy User?   @relation("TaskApprover", fields: [approvedById], references: [id])

  statusHistory TaskStatusHistory[]
  tickets       Ticket[] // Reverse relation for tickets linked to this task

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([type])
  @@index([approvedById])
}

model TaskStatusHistory {
  id          String     @id @default(uuid())
  taskId      String
  oldStatus   TaskStatus
  newStatus   TaskStatus
  changedById String

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("TaskStatusChanger", fields: [changedById], references: [id])

  changedAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// TICKETS
//////////////////////////////////////////////////////
model Ticket {
  id String @id @default(uuid())

  projectId   String
  taskId      String? // Optional link to task
  title       String
  description String
  type        TicketType

  priority Priority     @default(MEDIUM)
  status   TicketStatus @default(OPEN)

  reporterId   String
  assignedToId String?

  slaDueAt  DateTime?
  escalated Boolean   @default(false)

  resolution String?
  resolvedAt DateTime?
  closedAt   DateTime?

  isDeleted Boolean @default(false)

  project  Project @relation(fields: [projectId], references: [id])
  task     Task?   @relation(fields: [taskId], references: [id])
  reporter User    @relation("TicketReporter", fields: [reporterId], references: [id])
  assignee User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  statusHistory TicketStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([projectId])
  @@index([taskId])
}

//////////////////////////////////////////////////////
// SELF WORK
//////////////////////////////////////////////////////

model SelfWork {
  id             String         @id @default(uuid())
  projectId      String
  userId         String
  title          String
  description    String
  estimatedHours Float
  status         ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("SelfWorkOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("SelfWorkApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// ATTENDANCE & LEAVE
//////////////////////////////////////////////////////

model Attendance {
  id           String           @id @default(uuid())
  userId       String
  date         DateTime         @db.Date
  firstCheckIn DateTime?
  lastCheckOut DateTime?
  totalHours   Float            @default(0)
  status       AttendanceStatus @default(PRESENT)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
}

model AttendanceSession {
  id        String    @id @default(uuid())
  userId    String
  checkIn   DateTime
  checkOut  DateTime?
  latitude  Float?
  longitude Float?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkIn])
}

model LeaveRequest {
  id           String         @id @default(uuid())
  userId       String
  type         LeaveType
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  reason       String
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?

  user       User  @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("LeaveApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// WFH REQUESTS
//////////////////////////////////////////////////////

model WfhRequest {
  id           String         @id @default(uuid())
  userId       String
  fromDate     DateTime       @db.Date
  toDate       DateTime       @db.Date
  reason       String
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?

  user       User  @relation("WfhRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("WfhApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, fromDate, toDate])
  @@index([status])
}

//////////////////////////////////////////////////////
// FINANCE
//////////////////////////////////////////////////////

model ProjectFinance {
  id           String @id @default(uuid())
  projectId    String @unique
  totalIncome  Float  @default(0)
  totalExpense Float  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Revenue {
  id           String   @id @default(uuid())
  projectId    String
  amount       Float
  receivedDate DateTime
  description  String?
  createdById  String

  // Extended fields (nullable — safe for existing records)
  paymentMethod PaymentMethod?
  bankAccountId String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("RevenueCreator", fields: [createdById], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Invoice back-relation (one-to-one, optional)
  invoice Invoice?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([receivedDate])
  @@index([bankAccountId])
}

model Expense {
  id          String  @id @default(uuid())
  amount      Float
  expenseDate DateTime
  employeeId  String?
  projectId   String?
  description String?
  createdById String

  // Extended fields
  paymentMethod PaymentMethod?
  bankAccountId String?
  categoryId    String         // required — every expense must have a category

  employee    User?           @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  bankAccount BankAccount?    @relation(fields: [bankAccountId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([employeeId])
  @@index([expenseDate])
  @@index([bankAccountId])
  @@index([categoryId])
}

//////////////////////////////////////////////////////
// FINANCE — EXTENDED MODELS
//////////////////////////////////////////////////////

model BankAccount {
  id            String  @id @default(cuid())
  name          String
  accountNumber String  @unique
  bankName      String
  ifscCode      String?
  isActive      Boolean @default(true)

  revenues  Revenue[]
  expenses  Expense[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model LedgerEntry {
  id            String              @id @default(cuid())
  type          LedgerEntryType
  referenceType LedgerReferenceType
  amount        Float
  date          DateTime
  description   String?
  referenceId   String
  createdById   String

  createdBy User @relation("LedgerEntryCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
  @@index([referenceId])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  projectId      String
  clientName     String
  clientAddress  String?
  clientGSTIN    String?
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  totalAmount    Float
  notes          String?
  pdfPath        String?
  revenueId      String?       @unique
  createdById    String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revenue   Revenue? @relation(fields: [revenueId], references: [id])
  createdBy User     @relation("InvoiceCreator", fields: [createdById], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

//////////////////////////////////////////////////////
// CHAT
//////////////////////////////////////////////////////

enum ChatRoomType {
  COMPANY
  TEAM
  PROJECT
  DIRECT
}

model ChatRoom {
  id        String       @id @default(uuid())
  name      String
  type      ChatRoomType
  projectId String?

  project  Project?         @relation(fields: [projectId], references: [id])
  members  ChatRoomMember[]
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, projectId])
  @@index([type])
  @@index([projectId])
}

model ChatMessage {
  id        String  @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  isDeleted Boolean  @default(false)
  isEdited  Boolean  @default(false)

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

model ChatRoomMember {
  id     String @id @default(uuid())
  roomId String
  userId String

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation("ChatRoomMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

// Legacy models (keeping for backward compatibility)
model Channel {
  id        String      @id @default(uuid())
  type      ChannelType
  projectId String?

  project  Project?  @relation(fields: [projectId], references: [id])
  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id        String  @id @default(uuid())
  channelId String
  senderId  String
  content   String
  fileUrl   String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// SYSTEM
//////////////////////////////////////////////////////

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  entityType String?
  entityId   String?
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model ActivityFeed {
  id          String @id @default(uuid())
  userId      String
  actionType  String
  description String
  entityType  String
  entityId    String
  metadata    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model AuditLog {
  id        String  @id @default(uuid())
  actorId   String
  action    String
  module    String
  entityId  String?
  ipAddress String?

  actor User @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())
}

model FileAttachment {
  id           String @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  entityType   String
  entityId     String
  uploadedById String

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([uploadedById])
}

//////////////////////////////////////////////////////
// COMMENTS (generic — supports ticket, task, file, etc.)
//////////////////////////////////////////////////////

model Comment {
  id         String  @id @default(uuid())
  entityType String  // "ticket" | "task" | "file"
  entityId   String
  authorId   String
  content    String
  isDeleted  Boolean @default(false)

  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([authorId])
}

//////////////////////////////////////////////////////
// HOLIDAYS
//////////////////////////////////////////////////////

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  name        String
  description String?
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

//////////////////////////////////////////////////////
// AUTH — REFRESH TOKENS
//////////////////////////////////////////////////////

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique  // bcrypt hash of the raw token — never store raw
  expiresAt DateTime
  revokedAt DateTime?           // null = active; non-null = revoked
  userAgent String?             // optional: browser/device fingerprint
  ipAddress String?             // optional: anomaly detection

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// TICKET HISTORY
//////////////////////////////////////////////////////

model TicketStatusHistory {
  id String @id @default(uuid())

  ticketId    String
  oldStatus   TicketStatus
  newStatus   TicketStatus
  changedById String

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([ticketId])
}
